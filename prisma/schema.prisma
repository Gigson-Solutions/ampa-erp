generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth) ───────────────────────────────────────────────────────────
// Nota: sin proveedor OAuth — solo Email (magic link). VerificationToken es lo que
// NextAuth usa para el token de un solo uso enviado por email.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  ampaRoles     UserAmpaRole[]

  // Superadmin de PLATAFORMA (equipo de Gigson/la ONG) — deliberadamente distinto
  // del valor de enum `AmpaRole.SUPERADMIN` en `UserAmpaRole`, que es un rol MÁS
  // dentro de la matriz de permisos de UNA AMPA concreta (ver plan de visión >
  // Roles: "superadmin (plataforma) · presidencia/secretaría/tesorería/vocal
  // (junta)" — son dos conceptos distintos a propósito). Este flag da acceso
  // transversal de solo lectura a `/admin` (todas las AMPAs), gestionado con
  // `requirePlatformAdmin()`, nunca con `requireAmpaRole()`.
  isPlatformAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─── Roles por AMPA ─────────────────────────────────────────────────────────────
// Un mismo usuario puede tener roles en varias AMPAs (p. ej. una empresa proveedora
// de extraescolares que trabaja para varias). El ampaId de sesión activo se resuelve
// por subdominio en middleware.ts; este modelo es la matriz de permisos real.

enum AmpaRole {
  // Rol de gestión dentro de ESTA AMPA (p.ej. alguien de Gigson dado de alta como
  // soporte puntual de una AMPA concreta) — NO es lo mismo que `User.isPlatformAdmin`
  // (acceso transversal a todas las AMPAs vía `/admin`). Ver comentario en `User`.
  SUPERADMIN
  PRESIDENCIA
  SECRETARIA
  TESORERIA
  VOCAL
  COMISION
  FAMILIA
  PROVEEDOR
  MONITOR
}

model UserAmpaRole {
  id     String   @id @default(cuid())
  userId String
  ampaId String
  role   AmpaRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  ampa Ampa @relation(fields: [ampaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, ampaId, role])
  @@index([ampaId])
  @@map("user_ampa_roles")
}

// ─── Centro educativo (contexto, no tenant) ────────────────────────────────────

model Center {
  id   String @id @default(cuid())
  name String
  code String @unique

  ampas  Ampa[]
  groups Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("centers")
}

model Group {
  id       String @id @default(cuid())
  centerId String
  name     String // p.ej. "1º ESO A"

  center   Center    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  students Student[]

  createdAt DateTime @default(now())

  @@index([centerId])
  @@map("groups")
}

// ─── AMPA (TENANT) ──────────────────────────────────────────────────────────────
// Raíz de aislamiento multi-tenant. Toda tabla de negocio de aquí en adelante lleva
// ampaId y está sujeta a RLS (ver prisma/migrations/*_rls/migration.sql).

model Ampa {
  id        String  @id @default(cuid())
  centerId  String
  name      String
  subdomain String  @unique
  locale    String  @default("es") // es | ca | eu | gl | va
  active    Boolean @default(true)

  // Datos bancarios/SEPA — por-AMPA, nunca centralizados (cada AMPA es su propio
  // acreedor). Nulos hasta completar el onboarding bancario (Fase 1).
  sepaCreditorId   String?
  sepaCreditorName String?
  sepaIban         String?

  center Center @relation(fields: [centerId], references: [id])

  academicYears AcademicYear[]
  userRoles     UserAmpaRole[]
  families      Family[]
  feeSchemas    FeeSchema[]
  charges       Charge[]
  payments      Payment[]
  activities    Activity[]
  events        Event[]
  providers     Provider[]
  announcements Announcement[]
  documents     Document[]
  ledgerEntries LedgerEntry[]
  minutesEntries MinutesEntry[]
  expenseForecasts ExpenseForecast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ampas")
}

model AcademicYear {
  id        String   @id @default(cuid())
  ampaId    String
  label     String // p.ej. "2026-2027"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  ampa       Ampa         @relation(fields: [ampaId], references: [id], onDelete: Cascade)
  students   Student[]
  memberships Membership[]
  feeSchemas  FeeSchema[]
  activities  Activity[]

  createdAt DateTime @default(now())

  @@unique([ampaId, label])
  @@index([ampaId])
  @@map("academic_years")
}

// ─── Familias ────────────────────────────────────────────────────────────────

model Family {
  id            String @id @default(cuid())
  ampaId        String
  referenceCode String // código interno del AMPA, p.ej. para banco de libros

  // Carnet digital con QR (ver roadmap): token opaco no adivinable, distinto del
  // `id` (cuid), para que la URL pública de verificación (`/[ampa]/carnet/[token]`)
  // no sea enumerable ni exponga el id interno. Nullable a propósito — se genera
  // de forma perezosa la primera vez que se pide (ver src/lib/card.ts), así no
  // hace falta backfilear las familias ya existentes en una migración.
  cardToken String? @unique

  ampa       Ampa         @relation(fields: [ampaId], references: [id], onDelete: Cascade)
  guardians  Guardian[]
  students   Student[]
  memberships Membership[]
  charges     Charge[]
  consents    Consent[]
  eventRegistrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ampaId])
  @@map("families")
}

model Guardian {
  id       String  @id @default(cuid())
  familyId String
  userId   String?
  name     String
  email    String
  phone    String?

  // Libro de socios (LO 1/2002): un socio/a es una persona por familia — el
  // "tutor legal" (`isLegalMember = true`). Una familia puede tener además
  // otros `Guardian` sin este flag, que son solo personas de contacto (no
  // socios de la asociación). DNI/dirección son los datos mínimos exigidos
  // para el registro formal de socios; nullable porque las personas de
  // contacto no los necesitan y las familias existentes antes de esta pieza
  // no los tienen todavía.
  dni            String?
  address        String?
  isLegalMember  Boolean   @default(false)
  memberJoinedAt DateTime?
  memberLeftAt   DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([familyId])
  @@map("guardians")
}

model Student {
  id             String  @id @default(cuid())
  familyId       String
  academicYearId String?
  groupId        String?
  name           String
  birthDate      DateTime?

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  group        Group?        @relation(fields: [groupId], references: [id])
  consents     Consent[]
  activityEnrollments ActivityEnrollment[]

  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([academicYearId])
  @@map("students")
}

// ─── Cuotas y cobros ─────────────────────────────────────────────────────────

model FeeSchema {
  id             String @id @default(cuid())
  ampaId         String
  academicYearId String
  name           String
  amount         Decimal @db.Decimal(10, 2)
  discountRules  Json? // hermanos, familia numerosa, beca, etc.

  ampa         Ampa         @relation(fields: [ampaId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  memberships  Membership[]

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("fee_schemas")
}

model Membership {
  id             String   @id @default(cuid())
  ampaId         String
  familyId       String
  academicYearId String
  feeSchemaId    String?
  status         String   @default("ACTIVE") // ACTIVE | PENDING | CANCELLED

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  feeSchema    FeeSchema?    @relation(fields: [feeSchemaId], references: [id])

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("memberships")
}

model Charge {
  id       String   @id @default(cuid())
  ampaId   String
  familyId String
  concept  String
  amount   Decimal  @db.Decimal(10, 2)
  dueDate  DateTime
  status   String   @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED

  ampa     Ampa      @relation(fields: [ampaId], references: [id], onDelete: Cascade)
  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments Payment[]

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@index([familyId])
  @@map("charges")
}

model Payment {
  id       String   @id @default(cuid())
  ampaId   String
  chargeId String
  method   String // STRIPE_CARD | STRIPE_BIZUM | SEPA | TRANSFER | CASH
  amount   Decimal  @db.Decimal(10, 2)
  status   String   @default("PENDING") // PENDING | SETTLED | FAILED | REFUNDED
  paidAt   DateTime?

  ampa   Ampa   @relation(fields: [ampaId], references: [id], onDelete: Cascade)
  charge Charge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@index([chargeId])
  @@map("payments")
}

// ─── Extraescolares y eventos ────────────────────────────────────────────────

model Provider {
  id           String  @id @default(cuid())
  ampaId       String
  name         String
  contactEmail String?

  ampa       Ampa       @relation(fields: [ampaId], references: [id], onDelete: Cascade)
  activities Activity[]

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("providers")
}

model Activity {
  id             String  @id @default(cuid())
  ampaId         String
  academicYearId String
  providerId     String?
  name           String
  capacity       Int?
  price          Decimal @db.Decimal(10, 2)

  // Monitor asignado (feedback de usuario, 2026-08-11) — sin relación formal
  // de Prisma a propósito, igual que `Guardian.userId`: nunca se navega desde
  // `User` hacia sus actividades vía Prisma, solo se filtra por este campo
  // (ver src/lib/monitors.ts). Una misma persona puede ser monitor de varias
  // actividades distintas, un monitor por actividad en esta primera versión.
  monitorUserId String?

  // Pago fraccionado (feedback de usuario, 2026-08-11: "el viaje de fin de
  // curso no es un concepto aparte, es una actividad más donde se configura
  // la cantidad y recurrencia de los plazos"). `null` o `1` = cobro único,
  // como cualquier extraescolar. Ver enrollStudentInActivity en
  // src/lib/activities.ts, que genera el/los `Charge` correspondientes.
  installmentCount         Int?
  installmentRecurrenceDays Int?

  ampa         Ampa                 @relation(fields: [ampaId], references: [id], onDelete: Cascade)
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  provider     Provider?            @relation(fields: [providerId], references: [id])
  enrollments  ActivityEnrollment[]

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("activities")
}

// Sin `ampaId` propio a propósito — igual que Guardian/Student/Consent, se aísla
// transitivamente a través de `Activity.ampaId` (ver src/lib/activities.ts, que
// SIEMPRE verifica primero que la actividad pertenece a la AMPA activa antes de
// tocar inscripciones).
model ActivityEnrollment {
  id         String @id @default(cuid())
  activityId String
  studentId  String
  status     String @default("ENROLLED") // ENROLLED | WAITLISTED | CANCELLED

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())

  @@unique([activityId, studentId])
  @@index([activityId])
  @@map("activity_enrollments")
}

// Fase 1: "asistencia". Sin `ampaId` propio — se aísla transitivamente a través de
// `ActivityEnrollment` -> `Activity` (mismo patrón que ActivityEnrollment mismo).
// Un registro por (inscripción, fecha) — se puede corregir marcando de nuevo el
// mismo día (upsert), no se acumulan duplicados.
model AttendanceRecord {
  id           String   @id @default(cuid())
  enrollmentId String
  date         DateTime @db.Date
  present      Boolean

  enrollment ActivityEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([enrollmentId, date])
  @@index([enrollmentId])
  @@map("attendance_records")
}

model Event {
  id       String   @id @default(cuid())
  ampaId   String
  name     String
  date     DateTime
  capacity Int?
  price    Decimal? @db.Decimal(10, 2)

  ampa          Ampa                @relation(fields: [ampaId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("events")
}

// Sin `ampaId` propio a propósito — igual que ActivityEnrollment, se aísla
// transitivamente a través de `Event.ampaId` Y `Family.ampaId` (ambos SÍ están en
// TENANT_SCOPED_MODELS, así que `db.event.findUnique`/`db.family.findUnique` ya
// devuelven null si pertenecen a otra AMPA — ver src/lib/events.ts).
model EventRegistration {
  id            String @id @default(cuid())
  eventId       String
  familyId      String
  attendeeCount Int    @default(1)
  status        String @default("REGISTERED") // REGISTERED | WAITLISTED | CANCELLED

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, familyId])
  @@index([eventId])
  @@map("event_registrations")
}

// ─── Comunicación y documentos ───────────────────────────────────────────────

model Announcement {
  id      String    @id @default(cuid())
  ampaId  String
  title   String
  body    String
  segment Json? // filtros de segmentación (curso, grupo, estado de pago, rol, idioma)
  sentAt  DateTime?

  ampa Ampa @relation(fields: [ampaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("announcements")
}

model Document {
  id       String @id @default(cuid())
  ampaId   String
  title    String
  url      String
  category String?

  ampa Ampa @relation(fields: [ampaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("documents")
}

// ─── RGPD de menores ─────────────────────────────────────────────────────────
// Consentimientos versionados con evidencia de firma (IP + timestamp + hash).

model Consent {
  id         String   @id @default(cuid())
  familyId   String
  studentId  String?
  type       String // DATA | IMAGE | CENTER_SHARE
  version    String
  accepted   Boolean
  ip         String
  hash       String
  acceptedAt DateTime @default(now())

  family  Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])

  @@index([familyId])
  @@map("consents")
}

// ─── Contabilidad (PGC ESFL simplificada) ────────────────────────────────────

model LedgerEntry {
  id          String   @id @default(cuid())
  ampaId      String
  date        DateTime
  account     String // código de cuenta PGC ESFL
  debit       Decimal  @default(0) @db.Decimal(10, 2)
  credit      Decimal  @default(0) @db.Decimal(10, 2)
  description String

  ampa Ampa @relation(fields: [ampaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("ledger_entries")
}

// ─── Fase 2: libro de actas (LO 1/2002) ──────────────────────────────────────
// Numeración correlativa inmutable + cadena de hashes (cada asiento incluye el
// hash del anterior) — prueba documental de que ningún acta se ha insertado,
// borrado o modificado a posteriori. Sin update/delete a propósito: solo existen
// `createMinutesEntry` y `verifyMinutesChain` en src/lib/minutes.ts. La firma
// (nombre de quien firma + timestamp) se captura EN LA CREACIÓN, nunca después,
// para no tener que mutar un asiento ya hasheado.
model MinutesEntry {
  id             String   @id @default(cuid())
  ampaId         String
  sequenceNumber Int
  title          String
  body           String
  previousHash   String? // null solo en el primer asiento del libro
  hash           String
  signedByName   String
  signedAt       DateTime

  ampa Ampa @relation(fields: [ampaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ampaId, sequenceNumber])
  @@index([ampaId])
  @@map("minutes_entries")
}

// ─── Fase 2: impagos y previsión de tesorería ────────────────────────────────
// Gasto previsto simple (alquiler de autobús, material, catering...), sin
// códigos de cuenta PGC ni doble entrada — deliberadamente separado de
// `LedgerEntry` (contabilidad PGC ESFL formal, todavía sin construir) para no
// mezclar "previsión de caja rápida para la junta" con la contabilidad legal
// completa. Si en el futuro se decide unificarlos, se puede migrar entonces.
model ExpenseForecast {
  id           String   @id @default(cuid())
  ampaId       String
  description  String
  amount       Decimal  @db.Decimal(10, 2)
  expectedDate DateTime
  status       String   @default("PLANNED") // PLANNED | PAID

  ampa Ampa @relation(fields: [ampaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ampaId])
  @@map("expense_forecasts")
}
