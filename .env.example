# Postgres (docker-compose local)
POSTGRES_USER=ampa_erp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ampa_erp
# Cambiar si el 5432 local ya está ocupado (Postgres.app, otro proyecto, etc.)
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://ampa_erp:change-me@localhost:5432/ampa_erp

# NextAuth
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Email provider (magic link) — Amazon SES en producción.
# En desarrollo, sendVerificationRequest solo hace console.log si estas no están.
AUTH_EMAIL_FROM=no-reply@ampas.org
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Multi-tenant / dominio base para resolver subdominios en middleware.ts
ROOT_DOMAIN=ampas.org
